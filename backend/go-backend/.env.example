# ============================================
# Resume Backend - Environment Configuration
# ============================================
# Copy this file to .env and update with your values
# cp env.example .env

# ============================================
# Server Configuration
# ============================================
PORT=8080
UPLOAD_DIR=uploads

# ============================================
# Database Configuration
# ============================================
# For local development (outside Docker)
DB_HOST=localhost
# For Docker Compose, use: postgres
# DB_HOST=postgres

DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=resume_db
DB_SSLMODE=disable
DB_ENABLED=true

# ============================================
# Cloudinary Configuration (Optional)
# ============================================
# Set CLOUDINARY_ENABLED=true to use Cloudinary for file storage
# Otherwise, files will be stored locally in UPLOAD_DIR
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=resume-ocr

# ============================================
# Authentication Configuration
# ============================================
# IMPORTANT: Change JWT_SECRET to a strong random string in production!
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-strong-random-secret
JWT_EXPIRY_HOURS=24
REFRESH_EXPIRY_DAYS=30
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# ============================================
# OAuth Providers Configuration
# ============================================
# Enable providers by setting *_ENABLED=true and providing credentials

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft OAuth (Azure AD)
# Get credentials from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
