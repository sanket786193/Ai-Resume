# Server
HOST=0.0.0.0
PORT=8000
# gRPC (for Go backend); set GRPC_ENABLED=true to run gRPC server in same process
GRPC_PORT=50051
GRPC_ENABLED=false

# Go backend (for optional job fetch)
GO_BACKEND_URL=http://localhost:8080
GO_BACKEND_TIMEOUT_SEC=30

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SEC=120

# Logging
LOG_LEVEL=INFO
