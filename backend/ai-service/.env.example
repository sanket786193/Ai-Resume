# Server
HOST=0.0.0.0
PORT=8000
# gRPC (for Go backend); set GRPC_ENABLED=true to run gRPC server in same process
GRPC_PORT=50051
GRPC_ENABLED=false

# Go backend (for optional job fetch)
GO_BACKEND_URL=http://localhost:8080
GO_BACKEND_TIMEOUT_SEC=30

# Ollama (local LLM) - run: ollama pull llama3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT_SEC=55
# Optional: OLLAMA_EMBED_MODEL=nomic-embed-text, OLLAMA_EMBED_DIM=768

# Logging
LOG_LEVEL=INFO
